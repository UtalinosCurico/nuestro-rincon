<!--
  Le dice al build que NO elimine el módulo de física.
  Sin esto, el stripping se lleva SphereCollider y CapsuleCollider, que
  GameObject.CreatePrimitive necesita al crear esferas y cápsulas: los
  objetos fallaban al crearse y la sala salía vacía.
-->
<linker>
  <assembly fullname="UnityEngine.PhysicsModule" preserve="all"/>
  <assembly fullname="UnityEngine.CoreModule" preserve="all"/>
</linker>
